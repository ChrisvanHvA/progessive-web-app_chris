<section class="contact">
    <div class="bar">

        <% if(typeof userData == 'undefined' || userData.length == 0) { %>

            <picture>
                <img id="pfpic" src="images/pfpic.png">
            </picture>
        
            <p id="username"><%= userData.name %></p>
            <p id="bio"><%= userData.bio %></p>
        
            <ul>
                <li>
                    <p id="followers">followers: <%= userData.followers %></p>
                </li>
                <li>
                    <p id="following">following: <%= userData.following %></p>
                </li>
            </ul>

            <% } else { %>
                <h2>Contact info</h2>
                <button><img alt="close" src="images/close.png"></button>
            </div>
            <ul>
                <li><img alt="email" src="images/email.png">
                    <a href="www.google.com" id="email"><%= userData.email %> chris.gabriel@hotmail.nl</a>
        
                <li><img alt="work" src="images/work.png">
                    <a id="work"><%= userData.company %></a>
                </li>
                <li><img alt="github" src="images/github.png">
                    <a href="<%= userData.url %>" id="github"> github</a>
                </li>
                <li>
                    <p id="date">on github since <%= userData.created_at %></p>




                    </li>
                </ul>
        
            <% } %>
     