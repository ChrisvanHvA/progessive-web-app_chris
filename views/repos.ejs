<html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title></title>
        <meta name="description" content="">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="/public/style.css">
    </head>
    <body>
        <!--[if lt IE 7]>
            <p class="browsehappy">You are using an <strong>outdated</strong> browser. Please <a href="#">upgrade your browser</a> to improve your experience.</p>
        <![endif]-->
        

<section class="repositories">
    <div class="bar">

        <h2>Repositories</h2>
        <button><img src="/images/close.png"></button>
    </div>
    <h2>Here are some interesting repo's from me</h2>
 


<% if(typeof userData == 'undefined' || userData.length == 0) { %>

    <div id="repo">die komen hier</div>

    <% } else { %>
        <div id="repo">
        <ul >
            <% repos.forEach(repo => { %>
           
                <li><a href="<%= repo.html_url %>"><p>
                    <%= repo.name %> <br> <%= repo.description %></p></a></li>
            <% }) %>
        </ul>
        </div>
    <% } %>
</section>
<script src="/scripts/repos.js" defer></script>
</body>
</html>
