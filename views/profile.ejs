<section class="profile">

    <div class="bar">
        <h2>Profile</h2>
        <button aria-label="close function"><img alt="close" src="images/close.png"></button>
    </div>

    <% if(typeof userData == 'undefined' || userData.length == 0) { %>

        <picture>
            <img alt="profile pic" id="profile pic" src="images/pfpic.webp">
        </picture>
    
        <p id="username">generic name</p>
        <p id="bio">bio</p>
    
        <ul>
            <li>
                <p id="followers">followers:</p>
            </li>
            <li>
                <p id="following">following:</p>
            </li>
        </ul>

    <% } else { %>

        <picture>
            <img alt="profile" id="pfpic" src="images/pfpic.webp">
        </picture>
    
        <p id="username"><%= userData.name %></p>
        <p id="bio"><%= userData.bio %></p>
    
        <ul>
            <li>
                <p id="followers">followers: <%= userData.followers %></p>
            </li>
            <li>
                <p id="following">following: <%= userData.following %></p>
            </li>
        </ul>

    <% } %>
    